# Public URL of the site (used for metadata, sitemap and share previews).
NEXT_PUBLIC_SITE_URL=http://localhost:3200

# Allow search engines to index the site. Keep false until launch is approved.
SITE_INDEXING=false

# Show draft content (campaigns, founder note, unconfirmed bio lines) with visible markers.
# Never enable on the public site.
CONTENT_PREVIEW=false

# ---- Forms (volunteer, partner, institutional, contact) ----
# Preferred: a webhook that stores or forwards enquiries (NGOSutra, CRM, Apps Script, Zapier...).
# The site shows success only after the webhook returns a 2xx response.
FORMS_WEBHOOK_URL=
# Sent as the X-Webhook-Secret header so the receiver can authenticate the site.
FORMS_WEBHOOK_SECRET=
# Development only: store enquiries in a local JSONL file instead. Ignored in production.
# FORMS_STORE=file
# FORMS_FILE_PATH=.data/enquiries.jsonl

# ---- Donations ----
# Donations stay off unless every condition below is met.
DONATIONS_ENABLED=false
# razorpay (hosted Payment Links) or mock (development only, never in production)
PAYMENT_PROVIDER=
# test or live. Live requires rzp_live_ keys AND DONATION_ACCOUNT_VERIFIED=true.
PAYMENT_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set to true only once the foundation's own bank account is verified on the payment provider.
DONATION_ACCOUNT_VERIFIED=false
